{
  "name": "copilot-vscode-deepseek",
  "displayName": "DeepSeek for Copilot",
  "description": "Use DeepSeek V4 models in VS Code Copilot Chat with thinking effort presets & temperature presets",
  "version": "0.5.0",
  "type": "module",
  "publisher": "DenizhanDaklr",
  "repository": {
    "type": "git",
    "url": "https://github.com/zelosleone/DeepSeek-for-Copilot"
  },
  "icon": "images/Deepseek-Logo-Icon-PNG.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "deepseek",
    "deepseek v4",
    "copilot",
    "github copilot",
    "copilot chat",
    "language model",
    "thinking",
    "reasoning",
    "ai",
    "chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "deepseek",
        "displayName": "DeepSeek"
      }
    ],
    "commands": [
      {
        "command": "deepseek.setApiKey",
        "title": "DeepSeek: Set API Key"
      },
      {
        "command": "deepseek.setTemperature",
        "title": "DeepSeek: Set Temperature"
      },
      {
        "command": "deepseek.clearApiKey",
        "title": "DeepSeek: Clear API Key"
      },
      {
        "command": "deepseek.showLogs",
        "title": "DeepSeek: Show Logs"
      }
    ],
    "configuration": {
      "title": "DeepSeek",
      "properties": {
        "deepseek.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key (fallback if not set via command). Use 'DeepSeek: Set API Key' command for secure storage.",
          "scope": "application"
        },
        "deepseek.temperature": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "Default temperature when not set in model picker. Use 'DeepSeek: Set Temperature' command for presets + custom.",
          "scope": "application"
        },
        "deepseek.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DeepSeek API base URL",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "format": "biome format --write src/",
    "package": "vsce package"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "20.19.30",
    "@types/vscode": "^1.118.0",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "@typescript-eslint/parser": "8.53.0",
    "@vscode/vsce": "^2.25.0",
    "eslint": "9.39.2",
    "globals": "17.0.0",
    "typescript": "5.9.3"
  }
}
